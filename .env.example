# Database connection for Supabase PostgreSQL (e.g. postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/paper_trading

# Mistral AI API Configuration
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# 021 Trade Hackathon API Credentials
# UCC client code from Profile (format: HACK<number>, e.g. HACK1234)
ZERO21_UCC=HACK1234
ZERO21_PASSWORD=your_021_password_here
# Optional: Pre-generated Access Token (if already obtained via POST /auth/token or curl)
# If set, the engine reuses this token directly without re-authenticating.
ZERO21_ACCESS_TOKEN=f2afbdfa_47d556efc1ed7f7cbd2e2da3d6da8e897f5c583a00d44de127b48ce2cdd3d181
ZERO21_BASE_URL=https://devapi.021.trade/api/developer-api/v1
ZERO21_WS_BASE_URL=wss://devapi.021.trade/api/developer/websocket/market


